rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 도둑차 대탈주 순위표: 누구나 읽고, 각자 자기 기록 하나만 올림(최고점 갱신 때만).
    match /chase_scores/{uid} {
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nick', 'best', 'cash', 'time', 'wrecked', 'stars', 'at'])
          && d.nick is string && d.nick.size() > 0 && d.nick.size() <= 12
          && d.best is int && d.best > 0 && d.best <= 5000000
          && d.time is int && d.time >= 5 && d.time <= 36000
          && d.best <= (d.time + 10) * 4000
          && d.cash is int && d.cash >= 0
          && d.wrecked is int && d.wrecked >= 0 && d.wrecked <= 1000
          && d.stars is int && d.stars >= 1 && d.stars <= 5
          && d.at == request.time;
      }
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && valid();
      allow update: if request.auth != null && request.auth.uid == uid && valid()
        && request.resource.data.best > resource.data.best;
      allow delete: if false;
    }
    // 곡괭이 봉우리 순위표: 누구나 읽고, 각자 자기 기록 하나만 올림(번 골드가 줄어드는 덮어쓰기는 거부).
    match /rock_scores/{uid} {
      function validRock() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nick', 'earned', 'blocks', 'pick', 'best', 'at'])
          && d.nick is string && d.nick.size() > 0 && d.nick.size() <= 12
          && d.earned is int && d.earned >= 0 && d.earned <= 2000000000
          && d.blocks is int && d.blocks >= 0 && d.blocks <= 2000000000
          && d.pick is int && d.pick >= 0 && d.pick <= 5
          && d.best is int && d.best >= 0 && d.best <= 8
          && d.at == request.time;
      }
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && validRock();
      allow update: if request.auth != null && request.auth.uid == uid && validRock()
        && request.resource.data.earned >= resource.data.earned;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
